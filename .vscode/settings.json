{
  "memory-inspector.debugTypes": [
    "arm-debugger",
    "embedded-debug",
    "gdb",
    "mplab-core-da"
  ],
  "mplab.clangd.compileCommandsDir": "${workspaceFolder}\\_build\\CoffinReborn\\default",
  "mplab.clangd.path": "c:\\Program Files\\Microchip\\xc32\\v4.60\\bin\\xc32-clangd.exe",
  "C_Cpp.intelliSenseEngine": "disabled",
  // MPLAB's runcmake extension owns the CMake tree and the _build cache. Keep
  // ms-vscode.cmake-tools out of it -- it auto-activates on the generated
  // CMakeLists.txt and, with useCMakePresets:auto + automaticReconfigure, would
  // configure into the same _build dir that runcmake owns. Do not re-add
  // "cmake.sourceDirectory" here.
  "cmake.configureOnOpen": false,
  "cmake.ignoreCMakeListsMissing": true,
  "terminal.integrated.env.windows": {
    "PATH": "C:\\Users\\andre\\AppData\\Local\\Programs\\Python\\Python312\\Scripts;${env:PATH}"
  },
  "mplab.clangd.arguments": [
    "--header-insertion=never"
  ],
  "mplab.project.workspace.addNewSourceFiles": "Always"
}
